# Copy to .env.local (git-ignored) and fill in from Supabase:
# Project Settings -> API (or Connect -> App frameworks).
# Leave empty to build an app with no server: the Settings screen then says
# "not connected to a server" and Export is the only way data leaves a device.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
